{
  // Static-assets-only Worker: the site is prerendered at build time
  // (`npm run build`), so there is no server code and no `main` entry.
  // Keeping this file in the repo also stops Workers Builds' automatic
  // configuration from rewriting the Vite setup during deploy.
  // `name` must match the Worker name in the Cloudflare dashboard.
  "name": "sanskriti-website",
  "compatibility_date": "2026-09-01",
  // Serve the site only on the custom domains (added in the dashboard under
  // Settings → Domains & Routes). Without these two lines every deploy
  // turns the public *.workers.dev address and preview URLs back on.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  }
}
